{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build TaskManager",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-Wall",
                "-g",
                "main.cpp",
                "Task.cpp",
                "-o",
                "TaskManager.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}